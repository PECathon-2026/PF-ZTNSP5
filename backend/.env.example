# DevPilot / KAGE AI Backend Environment Configuration Example
# Copy this file to .env and configure local variables. Never commit real credentials!

# Host & Network
DEVPILOT_HOST=127.0.0.1
DEVPILOT_PORT=8000
DEVPILOT_DEBUG=false

# Persistence & Storage
DEVPILOT_DATA_DIR=./data
DEVPILOT_DB_PATH=./data/devpilot.db
DEVPILOT_ARTIFACTS_DIR=./data/artifacts

# Model Gateway (Server-Side Only - never exposed to browser or containers)
DEVPILOT_MODEL_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.argmin.run/v1
ANTHROPIC_API_KEY=your_key_here
DEVPILOT_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI alternative: set DEVPILOT_MODEL_PROVIDER=azure_openai
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Exact Azure deployment name, not a model catalog ID
AZURE_OPENAI_DEPLOYMENT=
# Use responses for reasoning-enabled function tools (including gpt-6-astra).
AZURE_OPENAI_API=responses
# Optional; use a value supported by the selected deployment, such as low.
AZURE_OPENAI_REASONING_EFFORT=

# Security & Isolation Limits
DEVPILOT_DOCKER_IMAGE=devpilot-checks:py312
DEVPILOT_MAX_REPAIR_ROUNDS=3
DEVPILOT_CHECK_TIMEOUT_SECONDS=60
DEVPILOT_MAX_FILE_SIZE_BYTES=524288

